# KHB EVENTS - Environment Configuration for sale.khbevents.com
PORT=3000
NODE_ENV=production
# Required in production: a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=https://sale.khbevents.com

# Supabase PostgreSQL Configuration (Optional - falls back to local JSON if not set)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Campaigns (Admin → Campaigns → Tracking setup). All optional.
# Server-side conversions: every new lead is also sent from the server to the ad platforms.
META_CAPI_ACCESS_TOKEN=
TIKTOK_EVENTS_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
# AI marketing analyst (Claude). Only aggregated numbers are sent.
ANTHROPIC_API_KEY=
