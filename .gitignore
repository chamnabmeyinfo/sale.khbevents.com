# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# legacy reference files
Old Project Code/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database temp files and corrupt-file backups
/data/*.tmp
/data/*.corrupt-*

# content-pack sync bundle built at build time
/.sync/

# admin image uploads in local development (production uses Supabase Storage)
/public/uploads/
/public/uploads-video/

# Obsidian vault (docs/): shared settings are committed; per-device state is not
/docs/.obsidian/workspace.json
/docs/.obsidian/workspace-mobile.json
/docs/.obsidian/cache
/docs/.obsidian/plugins/
/docs/.obsidian/community-plugins.json
/docs/.obsidian/graph.json
/docs/.trash/
/data/backups/
